{
  "name": "Lead Intake -> GHL",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body ?? $input.item.json;\nconst [firstName, ...rest] = String(body.name || '').trim().split(' ');\nreturn {\n  json: {\n    leadId: body.leadId,\n    firstName: firstName || '',\n    lastName: rest.join(' ') || '',\n    email: String(body.email || '').toLowerCase().trim(),\n    phone: body.phone,\n    service: body.service,\n    message: body.message,\n    tag: `new-lead-${body.service}`\n  }\n};"
      },
      "id": "normalize-node",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-07-28" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"locationId\": $env.GHL_LOCATION_ID,\n  \"firstName\": $json.firstName,\n  \"lastName\": $json.lastName,\n  \"email\": $json.email,\n  \"phone\": $json.phone,\n  \"tags\": [$json.tag],\n  \"source\": \"website-lead-form\",\n  \"customFields\": [\n    { \"key\": \"service_requested\", \"field_value\": $json.service },\n    { \"key\": \"initial_message\", \"field_value\": $json.message }\n  ]\n} }}",
        "options": {}
      },
      "id": "ghl-upsert-node",
      "name": "Upsert GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ghl-pit-token",
          "name": "GHL Private Integration Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"ghlContactId\": $json.contact?.id } }}"
      },
      "id": "respond-node",
      "name": "Respond to Website",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]]
    },
    "Normalize Payload": {
      "main": [[{ "node": "Upsert GHL Contact", "type": "main", "index": 0 }]]
    },
    "Upsert GHL Contact": {
      "main": [[{ "node": "Respond to Website", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
