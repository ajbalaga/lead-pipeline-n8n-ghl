# --- Postgres ---
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- App (Next.js) ---
# DATABASE_URL is built from POSTGRES_PASSWORD above via docker-compose.yml,
# you don't need to set it separately.
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/lead-intake
INTERNAL_API_TOKEN=replace-with-a-long-random-string

# --- Domains (used by Caddy + n8n) ---
APP_DOMAIN=app.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com

# --- n8n -> app callback (used only inside the n8n workflow's HTTP Request node,
#     set as an n8n credential/env, not required in this file for docker-compose) ---
# APP_STATUS_WEBHOOK_URL=https://app.yourdomain.com/api/leads/status

# --- GHL (set as n8n credentials/environment, not required in this file) ---
# GHL_PRIVATE_INTEGRATION_TOKEN=
# GHL_LOCATION_ID=
